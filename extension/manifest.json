{
  "manifest_version": 3,
  "name": "Aegis → 전적몬 자동 전적",
  "version": "1.0.0",
  "description": "Aegis(aegis-digi.online) 매치를 전적몬에 자동 기록합니다. (승/패 + 상대 덱 + 내 덱 자동 등록)",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "전적몬 연동",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://aegis-digi.online/*", "https://jeonjeokmon.vercel.app/*"],
  "content_scripts": [
    {
      "matches": ["https://aegis-digi.online/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
